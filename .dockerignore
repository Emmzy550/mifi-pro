# Exclude unnecessary files and directories
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
node_modules/
.git/
.gitignore
venv/
.venv/
ENV/
env/

# Exclude frontend build artifacts
frontend/node_modules/
frontend/src/
frontend/public/
frontend/.gitignore
frontend/index.html
frontend/postcss.config.js
frontend/tailwind.config.js
frontend/tsconfig.json
frontend/tsconfig.node.json
frontend/vite.config.ts
frontend/README.md

# Exclude test files
tests/
test_*.py
*_test.py
verify_*.py
debug_*.py
check_*.py
inspect_*.py
create_*.py
migrate_*.py
reconcile_*.py
repair_*.py
reset_*.py
seed_*.py
fix_*.py
find_*.py
final_*.py
diagnostic_*.py
demo_*.py
safety_*.py

# Exclude documentation
docs/
*.md
README.md

# Exclude HTML/CSS/JS files (not needed for backend, EXCEPT in dist)
*.html
*.css
*.js
*.json
!frontend/dist/**/*.html
!frontend/dist/**/*.css
!frontend/dist/**/*.js
!ml_models/*.json

# Exclude logs and temp files
*.log
*.txt
!requirements.txt
server_output
usage_*.json
test_output.json
synthetic_transactions.json

# Exclude secrets (but keep serviceAccountKey.json for Firebase Admin SDK)
# serviceAccountKey.json  # REQUIRED for Firebase - included in image
.env  # Environment variables set via Cloud Run
.firebaserc
firebase.json

# Exclude config files
.github/
.dockerignore
.gcloudignore
Procfile
